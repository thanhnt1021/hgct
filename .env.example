# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://nguydev:password@postgres:5432/zodiacdb"

# ─── NextAuth ─────────────────────────────────────────────────────
NEXTAUTH_URL="https://hatgiongchiemtinh.com"
NEXTAUTH_SECRET="generate: openssl rand -base64 32"

# ─── Google OAuth ─────────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx

# ─── OpenRouter AI (Claude Sonnet 4.6) ────────────────────────────
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MANAGEMENT_KEY="sk-or-..."  # for balance check endpoint

# ─── Email SMTP (Hostinger) ───────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@hatgiongchiemtinh.com
SMTP_PASS=your_email_password
EMAIL_FROM="Hạt Giống Chiêm Tinh <support@hatgiongchiemtinh.com>"

# ─── App URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://hatgiongchiemtinh.com"
NEXT_PUBLIC_DAISU_URL="https://daisu.hatgiongchiemtinh.com"
APP_PORT=65498

# ─── Encryption & Secrets ─────────────────────────────────────────
# generate: openssl rand -hex 32
PROFILE_ENCRYPTION_KEY=your_64_hex_key_here
CRON_SECRET=your_64_hex_cron_secret
# CTV_JWT_SECRET: same value as NEXTAUTH_SECRET to keep existing CTV sessions valid
CTV_JWT_SECRET="same_as_NEXTAUTH_SECRET"

# ─── Upgrade code (bcrypt-hashed, unified → lifetime) ─────────────
# Customer types plaintext code → bcrypt.compare vs hash → grants planType='lifetime'.
# Plaintext never stored. To rotate: generate new hash with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'NEW_CODE', bcrypt.gensalt(12)).decode())"
# Single-quote wrap so literal $ isn't shell-interpolated.
UPGRADE_CODE_HASH='$2b$12$replace_with_your_bcrypt_hash'

# ─── SePay Payment Gateway ────────────────────────────────────────
SEPAY_API_KEY="hgct_sepay_xxxx"
BANK_ACCOUNT_NUMBER=0000000000
BANK_ACCOUNT_NAME="ACCOUNT HOLDER NAME"
BANK_NAME=TPBank

# ─── Telegram Bots ────────────────────────────────────────────────
# Customer notify bot (order alerts, payment confirmations)
TELEGRAM_BOT_TOKEN=xxxx:xxxx

# Admin bot (restart services, check stats, price control)
TELEGRAM_ADMIN_BOT_TOKEN=xxxx:xxxx
TELEGRAM_ADMIN_WEBHOOK_SECRET=your_64_hex_url_secret     # part of webhook URL
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_64_hex_header_secret  # X-Telegram-Bot-Api-Secret-Token header
ADMIN_TELEGRAM_USER_ID=1234567890  # your Telegram user_id (only this ID can command the bot)
ADMIN_EMAILS=admin1@example.com,admin2@example.com  # comma-separated, dashboard access

# ─── Google Service Account (for KB Sync from Google Sheets) ──────
# base64-encoded service account JSON — has access to the KB spreadsheet
GOOGLE_SERVICE_ACCOUNT_BASE64="base64_encoded_service_account_json"
KB_SPREADSHEET_ID="google_sheets_id_for_knowledge_base"

# ─── Rate Limiting (Upstash Redis — optional) ─────────────────────
# Behind Cloudflare proxy already → rate limit optional
# To enable: create Upstash account at https://upstash.com → create Redis DB
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Cloudflare Turnstile (bot CAPTCHA for free preview endpoints) ─
# Create widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Mode: Invisible. Add hatgiongchiemtinh.com + demo.hatgiongchiemtinh.com.
NEXT_PUBLIC_CF_TURNSTILE_SITE_KEY="0x4AAAAAAyour_site_key_here"
CF_TURNSTILE_SECRET_KEY="0x4AAAAAAyour_secret_key_here"
