# ─────────────────────────────────────────────────────────────────
# Claude Code Telegram Notification — config template
# ─────────────────────────────────────────────────────────────────
# Copy to telegram_config.env, fill in real values, then:
#   chmod 600 telegram_config.env
#
# NEVER commit telegram_config.env to git. Only this .example is safe.
# ─────────────────────────────────────────────────────────────────

# From @BotFather when you create the bot, or reuse an existing send-only bot.
# Pattern: <bot_id>:<token_secret>
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Private chat id with the bot, or group id (negative number).
# To get: send a message to the bot, then curl
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Look for chat.id in the JSON.
CHAT_ID="YOUR_CHAT_ID_HERE"

# Optional: for forum-style groups with topics, set the thread_id to route
# notifications to a specific topic. Leave empty to post to group general.
TELEGRAM_THREAD_ID=""

# Skip notifications for tasks shorter than this (seconds). Anti-spam.
MIN_DURATION=3
