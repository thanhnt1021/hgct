'use client';

import Link from 'next/link';
import { Menu, X, User } from 'lucide-react';
import { useState } from 'react';

export function Navbar() {
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [isLoggedIn, setIsLoggedIn] = useState(false); // Mock state
  const [isDropdownOpen, setIsDropdownOpen] = useState(false);

  return (
    <header className="fixed top-0 left-0 right-0 z-50 bg-[#06060f]/88 backdrop-blur-[20px] border-b border-[#c8943f]/10 h-16">
      {/* Micro bar */}
      <div className="absolute top-0 left-0 right-0 h-4 bg-[#06060f] border-b border-[#c8943f]/5 flex items-center justify-center gap-2 text-[0.68rem] text-[#6b6585]">
        <Link href="#" className="hover:text-lunar-mid">Chính sách bảo mật</Link>
        <span>·</span>
        <Link href="#" className="hover:text-lunar-mid">Điều khoản sử dụng</Link>
      </div>

      <div className="max-w-6xl mx-auto px-4 h-full flex items-center justify-between pt-4">
        {/* Logo */}
        <Link href="/" className="flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="3" fill="#d9ab55"/>
            <circle cx="12" cy="4" r="1.5" fill="#d9ab55"/>
            <circle cx="20" cy="12" r="1.5" fill="#d9ab55"/>
            <circle cx="12" cy="20" r="1.5" fill="#d9ab55"/>
            <circle cx="4" cy="12" r="1.5" fill="#d9ab55"/>
            <path d="M12 4L12 9M20 12L15 12M12 20L12 15M4 12L9 12" stroke="#d9ab55" strokeWidth="1.5"/>
          </svg>
          <span className="font-vietnam text-[14px] text-gold-warm font-bold tracking-[0.05em] uppercase">
            Hạt Giống Chiêm Tinh
          </span>
        </Link>

        {/* Desktop Nav */}
        <nav className="hidden md:flex items-center gap-8">
          {/* Navigation links removed as requested */}
        </nav>

        {/* Mobile Toggle */}
        <button 
          className="md:hidden text-gold-warm p-2"
          onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
        >
          {isMobileMenuOpen ? <X size={24} /> : <Menu size={24} />}
        </button>
      </div>

      {/* Mobile Menu */}
      {isMobileMenuOpen && (
        <div className="md:hidden absolute top-16 left-0 right-0 bg-[#06060f]/95 backdrop-blur-xl border-b border-gold-base/20 p-4 flex flex-col gap-4 shadow-2xl">
