generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  userUid      String    @unique @map("user_uid")
  createdAt    String    @default("") @map("created_at")
  isPremium    Boolean  @default(false) @map("is_premium")
  planType     String   @default("free") @map("plan_type")
  premiumToken     String?   @map("premium_token")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  mainChartData    Json?     @map("main_chart_data")
  reportEmail      String?   @map("report_email")
  coin             Int      @default(0)
  coinUpdatedAt    DateTime? @map("coin_updated_at")
  profiles         Profile[]
  coinTransactions CoinTransaction[]

  @@map("users")
}

model CoinTransaction {
  id           Int      @id @default(autoincrement())
  userUid      String   @map("user_uid")
  delta        Int
  balanceAfter Int      @map("balance_after")
  reason       String
  refType      String   @map("ref_type")
  refId        String?  @map("ref_id")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userUid], references: [userUid])

  @@index([userUid, createdAt])
  @@map("coin_transactions")
}

// Persists unlocked section content per (user, profile, service, section).
// profileUid is the 16-char hash of the input data — keeps "same profile = same
// reading" stable even before Profile DB row exists (guest input).
model Reading {
  id         Int      @id @default(autoincrement())
  userUid    String   @map("user_uid")
  profileUid String   @map("profile_uid")
  service    String
  sectionId  String   @map("section_id")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userUid, profileUid, service, sectionId])
  @@index([userUid, profileUid, service])
  @@map("readings")
}

// Full generated essay per (user, profile, service) — persistent storage that
// replaces the old /tmp filesystem cache. Generated ONCE on the first unlock;
// every section is sliced from this same essay so a report stays consistent
// across unlocks and survives container restart/redeploy. Timeless: user can
// revisit forever.
model Essay {
  id         Int      @id @default(autoincrement())
  userUid    String   @map("user_uid")
  profileUid String   @map("profile_uid")
  service    String
  name       String?  // tên hồ sơ — để liệt kê "Hồ sơ đã xem"
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userUid, profileUid, service])
  @@map("essays")
}

// Lá số đã lưu của user (đăng nhập) — bản đồng bộ trên DB dùng chung → hiện ở
// mọi thiết bị/origin. Client vẫn lưu localStorage; khi đăng nhập thì gộp 2 nguồn.
// chartKey = fullKey phía client (người + view + service + người B, BẤT BIẾN thứ tự cho cặp đôi).
model SavedChart {
  id         Int      @id @default(autoincrement())
  userUid    String   @map("user_uid")
  chartKey   String   @map("chart_key")
  name       String
  view       String?
  service    String?
  inputData  Json     @map("input_data")
  inputDataB Json?    @map("input_data_b")
  savedAt    DateTime @default(now()) @map("saved_at")

  @@unique([userUid, chartKey])
  @@index([userUid])
  @@map("saved_charts")
}

model Profile {
  id         Int       @id @default(autoincrement())
  userUid    String    @map("user_uid")
  profileUid String    @unique @default("") @map("profile_uid")
  name       String
  gender     String?
  data       Json
  createdAt  String    @default("") @map("created_at")
  isTemp     Boolean   @default(false) @map("is_temp")
  tempExpiry DateTime? @map("temp_expiry")
  user       User      @relation(fields: [userUid], references: [userUid])

  @@map("profiles")
}

model KnowledgeBase {
  tabName   String @id @map("tab_name")
  data      Json
  updatedAt String @default("") @map("updated_at")

  @@map("knowledge_base")
}

model Job {
  id           String    @id
  status       String    @default("processing")
  progress     Int       @default(0)
  label        String    @default("")
  result       Json?
  error        String?
  userUid      String?   @map("user_uid")
  service      String?
  name         String?
  email        String?
  profileUidA  String?   @map("profile_uid_a")
  profileUidB  String?   @map("profile_uid_b")
  pdfExpiresAt DateTime? @map("pdf_expires_at")
  pdfNote      String?   @map("pdf_note")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("jobs")
}

model Order {
  id            Int       @id @default(autoincrement())
  userUid       String?   @map("user_uid")
  service       String
  profileData   Json      @map("profile_data")
  email         String
  status        String    @default("pending")
  pdfUrl        String?   @map("pdf_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  // SePay payment fields
  transferCode  String?   @unique @map("transfer_code")
  amount        Int?
  paymentStatus String    @default("unpaid") @map("payment_status")
  paidAt        DateTime? @map("paid_at")
  sepayTxnId    Int?      @unique @map("sepay_txn_id")
  jobId         String?   @map("job_id")

  // Extra input data for synastry/transit
  profileDataB  Json?     @map("profile_data_b")
  profileUidA   String?   @map("profile_uid_a")
  profileUidB   String?   @map("profile_uid_b")
  startDate     String?   @map("start_date")
  endDate       String?   @map("end_date")

  // Recovery system
  recoveryToken String?   @unique @map("recovery_token")
  retryCount    Int       @default(0)   @map("retry_count")

  // Claim Transfer (customer self-report payment)
  claimedAt     DateTime? @map("claimed_at")
  claimInfo     Json?     @map("claim_info")

  // Retarget email
  retargetEmailSentAt DateTime? @map("retarget_email_sent_at")

  // Retention email (7-day post-purchase follow-up)
  retentionEmailSentAt DateTime? @map("retention_email_sent_at")

  // Admin intentional cancel (immune to status resets)
  adminCancelledAt    DateTime? @map("admin_cancelled_at")

  // Idempotency key (checkout retry protection)
  idempotencyKey      String?   @unique @map("idempotency_key")

  // CTV referral
  ctvCode             String?   @map("ctv_code")

  ctvCommission       CtvCommission?

  @@map("orders")
}

model Ctv {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  name           String
  phone          String
  dob            String?
  passwordHash   String    @map("password_hash")
  ctvCode        String?   @unique @map("ctv_code")
  status         String    @default("pending_setup")  // pending_setup | active | disabled
  commissionRate Float     @default(0.10) @map("commission_rate")
  setupToken     String?   @map("setup_token")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  commissions    CtvCommission[]

  @@map("ctv")
}

model CtvCommission {
  id        Int       @id @default(autoincrement())
  ctvId     Int       @map("ctv_id")
  orderId   Int       @unique @map("order_id")
  amount    Int
  status    String    @default("pending")  // pending | paid
  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  ctv   Ctv   @relation(fields: [ctvId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@map("ctv_commissions")
}

model Config {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("config")
}
