generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  userUid      String    @unique @map("user_uid")
  createdAt    String    @default("") @map("created_at")
  isPremium    Boolean  @default(false) @map("is_premium")
  premiumToken     String?   @map("premium_token")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  profiles         Profile[]

  @@map("users")
}

model Profile {
  id        Int    @id @default(autoincrement())
  userUid   String @map("user_uid")
  name      String
  gender    String?
  data      Json
  createdAt String @default("") @map("created_at")
  user      User   @relation(fields: [userUid], references: [userUid])

  @@map("profiles")
}

model KnowledgeBase {
  tabName   String @id @map("tab_name")
  data      Json
  updatedAt String @default("") @map("updated_at")

  @@map("knowledge_base")
}

model Job {
  id        String   @id
  status    String   @default("processing")
  progress  Int      @default(0)
  label     String   @default("")
  result    Json?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("jobs")
}

model Order {
  id          Int      @id @default(autoincrement())
  userUid     String?  @map("user_uid")
  service     String
  profileData Json     @map("profile_data")
  email       String
  status      String   @default("pending")
  pdfUrl      String?  @map("pdf_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("orders")
}
