generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String?   @unique
  passwordHash String    @map("password_hash")
  userUid      String    @unique @map("user_uid")
  createdAt    String    @default("") @map("created_at")
  isPremium    Boolean  @default(false) @map("is_premium")
  planType     String   @default("free") @map("plan_type")
  premiumToken     String?   @map("premium_token")
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  mainChartData    Json?     @map("main_chart_data")
  reportEmail      String?   @map("report_email")
  profiles         Profile[]

  @@map("users")
}

model Profile {
  id         Int       @id @default(autoincrement())
  userUid    String    @map("user_uid")
  profileUid String    @unique @default("") @map("profile_uid")
  name       String
  gender     String?
  data       Json
  createdAt  String    @default("") @map("created_at")
  isTemp     Boolean   @default(false) @map("is_temp")
  tempExpiry DateTime? @map("temp_expiry")
  user       User      @relation(fields: [userUid], references: [userUid])

  @@map("profiles")
}

model KnowledgeBase {
  tabName   String @id @map("tab_name")
  data      Json
  updatedAt String @default("") @map("updated_at")

  @@map("knowledge_base")
}

model Job {
  id           String    @id
  status       String    @default("processing")
  progress     Int       @default(0)
  label        String    @default("")
  result       Json?
  error        String?
  userUid      String?   @map("user_uid")
  service      String?
  name         String?
  email        String?
  profileUidA  String?   @map("profile_uid_a")
  profileUidB  String?   @map("profile_uid_b")
  pdfExpiresAt DateTime? @map("pdf_expires_at")
  pdfNote      String?   @map("pdf_note")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("jobs")
}

model Order {
  id            Int       @id @default(autoincrement())
  userUid       String?   @map("user_uid")
  service       String
  profileData   Json      @map("profile_data")
  email         String
  status        String    @default("pending")
  pdfUrl        String?   @map("pdf_url")
  createdAt     DateTime  @default(now()) @map("created_at")

  // SePay payment fields
  transferCode  String?   @unique @map("transfer_code")
  amount        Int?
  paymentStatus String    @default("unpaid") @map("payment_status")
  paidAt        DateTime? @map("paid_at")
  sepayTxnId    Int?      @unique @map("sepay_txn_id")
  jobId         String?   @map("job_id")

  // Extra input data for synastry/transit
  profileDataB  Json?     @map("profile_data_b")
  profileUidA   String?   @map("profile_uid_a")
  profileUidB   String?   @map("profile_uid_b")
  startDate     String?   @map("start_date")
  endDate       String?   @map("end_date")

  // Recovery system
  recoveryToken String?   @unique @map("recovery_token")
  retryCount    Int       @default(0)   @map("retry_count")

  @@map("orders")
}
