[Unit]
Description=HGCT Demo Next.js App (demo.hatgiongchiemtinh.com)
After=network.target postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/hgct-demo/.next/standalone
Environment="PORT=65500"
Environment="NODE_ENV=production"
EnvironmentFile=/root/hgct-demo/.env.local
ExecStartPre=/bin/sh -c 'fuser -k 65500/tcp 2>/dev/null || true'
ExecStartPre=/bin/sleep 1
ExecStart=/usr/bin/node /root/hgct-demo/.next/standalone/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
